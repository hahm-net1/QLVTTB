{
  "entities": {
    "Voucher": {
      "title": "Voucher",
      "description": "Phiếu giao dịch tiếp nhận và quản lý vật tư thiết bị viễn thông",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Mã định danh duy nhất của phiếu" },
        "soChungTu": { "type": "string", "description": "Số chứng từ phiếu giao dịch" },
        "loaiChungTu": { "type": "string", "enum": ["PXK", "PNK", "GUI_MUON"], "description": "Loại chứng từ giao dịch" },
        "ngayTiepNhan": { "type": "string", "description": "Ngày tiếp nhận chứng từ" },
        "donViLienQuan": { "type": "string", "description": "Đơn vị liên quan hoặc phân bổ" },
        "canBoTiepNhan": { "type": "string", "description": "Họ tên cán bộ tiếp nhận" },
        "ghiChu": { "type": "string", "description": "Ghi chú chứng từ" },
        "danhSachVatTu": { "type": "string", "description": "Danh sách chi tiết vật tư thiết bị đính kèm phiếu" },
        "createdAt": { "type": "string", "description": "Thời gian tạo phiếu" },
        "updatedAt": { "type": "string", "description": "Thời gian cập nhật gần nhất" }
      },
      "required": ["id", "soChungTu", "loaiChungTu", "ngayTiepNhan", "canBoTiepNhan"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Vật tư tồn kho (tốt/lỗi) và Tài sản độc lập thuộc Kho tồn & Tài sản",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "maVT": { "type": "string" },
        "tenVT": { "type": "string" },
        "serialNumber": { "type": "string" },
        "soLuongTon": { "type": "number" },
        "soLuongBanDau": { "type": "number" },
        "donViTinh": { "type": "string" },
        "phanLoai": { "type": "string", "enum": ["CHUA_PHAN_LOAI", "VAT_TU_TOT", "VAT_TU_LOI", "TAI_SAN"] },
        "hangSanXuat": { "type": "string" },
        "dongThietBi": { "type": "string" },
        "viTriKho": { "type": "string" },
        "soChungTuGoc": { "type": "string" },
        "loaiChungTuGoc": { "type": "string" },
        "ngayNhap": { "type": "string" },
        "canBoNhap": { "type": "string" },
        "ghiChu": { "type": "string" },
        "privateNote": { "type": "string" },
        "migratedFromVoucherId": { "type": "string" },
        "migratedFromItemId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "tenVT", "soLuongTon", "soLuongBanDau", "phanLoai"]
    },
    "InventoryLog": {
      "title": "InventoryLog",
      "description": "Nhật ký nhập, xuất sử dụng, chuyển đổi trạng thái và điều chỉnh tồn kho",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemId": { "type": "string" },
        "loaiBienDong": { "type": "string", "enum": ["NHAP_MOI", "NHAP_CHUYEN_DOI", "XUAT_SU_DUNG", "DIEU_CHINH", "PHAN_LOAI", "TACH_DONG"] },
        "maVT": { "type": "string" },
        "tenVT": { "type": "string" },
        "serialNumber": { "type": "string" },
        "soLuongThayDoi": { "type": "number" },
        "tonTruoc": { "type": "number" },
        "tonSau": { "type": "number" },
        "nguoiThucHien": { "type": "string" },
        "nguoiNhan": { "type": "string" },
        "soChungTuThamChieu": { "type": "string" },
        "lyDo": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "itemId", "loaiBienDong", "tenVT", "soLuongThayDoi", "tonTruoc", "tonSau", "timestamp"]
    }
  },
  "firestore": {
    "/vouchers/{voucherId}": {
      "schema": "Voucher",
      "description": "Bộ sưu tập các chứng từ phiếu giao dịch vật tư thiết bị lưu trữ trên Firestore"
    },
    "/inventory_items/{itemId}": {
      "schema": "InventoryItem",
      "description": "Kho tồn & Tài sản độc lập (tách biệt với phiếu sửa chữa)"
    },
    "/inventory_logs/{logId}": {
      "schema": "InventoryLog",
      "description": "Lịch sử xuất - nhập - điều chỉnh Kho tồn & Tài sản"
    }
  }
}

